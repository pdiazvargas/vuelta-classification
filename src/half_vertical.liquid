<div class="layout layout--col gap--small">

  {% if has_gc %}
    {% if has_stage_result %}
      <span class="label label--filled no-shrink">STAGE {{ last_stage.number }} WINNERS</span>
      <div class="flex flex--col gap--xsmall w--full">
        {% for row in stage_rows limit: 3 %}
          <div class="flex flex--row flex--center-y gap--small w--full">
            <span class="value value--small value--tnums no-shrink w--5">{{ row.position }}</span>
            <span class="label label--small grow">{{ row.name | upcase | truncate: 20 }}</span>
          </div>
        {% endfor %}
      </div>

      <div class="divider"></div>
    {% endif %}

    <span class="label label--filled no-shrink">GC</span>
    <div class="flex flex--col gap--xsmall w--full">
      {% for row in gc_rows limit: 5 %}
        <div class="flex flex--row flex--center-y gap--small w--full">
          <span class="value value--small value--tnums no-shrink w--5">{{ row.position }}</span>
          <span class="label label--small grow">{{ row.name | upcase | truncate: 20 }}</span>
          <span class="value value--small value--tnums no-shrink">{% if row.gap %}+{{ row.gap }}{% else %}—{% endif %}</span>
        </div>
      {% endfor %}
    </div>
  {% else %}
    <div class="flex flex--row flex--center h--full w--full">
      <span class="label label--gray">GC not available yet</span>
    </div>
  {% endif %}

</div>

<div class="title_bar">
  <img class="image" src="data:image/svg+xml;base64,{{ title_bar_icon }}">
  <span class="title">Vuelta a España</span>
  <span class="instance">{% if last_stage %}Stage {{ last_stage.number }} of 21 · {{ last_stage_date_label }}{% else %}Classification{% endif %}</span>
</div>
