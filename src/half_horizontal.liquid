{%- comment -%}
  SCAFFOLD — see full.liquid comment. Top 5 only, single row per rider.
{%- endcomment -%}
<div class="layout layout--col gap--small">

  <div class="flex flex--row flex--center-y gap--small">
    <span class="title title--base">GC</span>
    {% if last_stage %}<span class="label label--gray label--small">AFTER STAGE {{ last_stage.number }}</span>{% endif %}
  </div>

  {% if has_gc %}
    <div class="flex flex--col gap--xsmall w--full">
      {% for row in gc_rows limit: 5 %}
        <div class="flex flex--row flex--center-y gap--small w--full">
          <span class="value value--small value--tnums no-shrink" style="width: 20px;">{{ row.position }}</span>
          <span class="label label--small" data-clamp="1" style="flex: 1;">{{ row.name | upcase }}</span>
          <span class="value value--small value--tnums no-shrink">
            {% if row.gap %}+{{ row.gap }}{% else %}—{% endif %}
          </span>
        </div>
      {% endfor %}
    </div>
  {% else %}
    <span class="label label--gray label--small">GC not available yet</span>
  {% endif %}

</div>

<div class="title_bar">
  <img class="image" src="data:image/svg+xml;base64,{{ title_bar_icon }}">
  <span class="title">Vuelta a España</span>
  <span class="instance">Classification</span>
</div>
