{%- comment -%}
  SCAFFOLD — plain ranked list, no visual design pass yet. Before treating
  this as final, load the frontend-design skill and rework layout/typography
  to match the sibling "Vuelta a España Stages" plugin's design language.
  Gap is shown in raw seconds ("+Ns") — proper mm:ss formatting is a TODO.
{%- endcomment -%}
<div class="layout layout--col gap--small">

  <div class="flex flex--row flex--center-y gap--small">
    <span class="title title--base">GENERAL CLASSIFICATION</span>
    {% if last_stage %}
      <span class="label label--gray">AFTER STAGE {{ last_stage.number }}</span>
    {% endif %}
  </div>

  <div class="divider"></div>

  {% if has_gc %}
    <div class="flex flex--col gap--small w--full">
      {% for row in gc_rows limit: 10 %}
        <div class="flex flex--row flex--center-y gap--small w--full">
          <span class="value value--small value--tnums no-shrink" style="width: 24px;">{{ row.position }}</span>
          <span class="label" data-clamp="1" style="flex: 1;">{{ row.name | upcase }}</span>
          <span class="label label--gray" data-clamp="1" style="flex: 1;">{{ row.team | upcase }}</span>
          <span class="value value--small value--tnums no-shrink">
            {% if row.gap %}+{{ row.gap }}{% else %}—{% endif %}
          </span>
        </div>
      {% endfor %}
    </div>
  {% else %}
    <div class="flex flex--row flex--center h--full w--full">
      <span class="label label--gray">General classification not available yet — check back once the race is underway (starts 2026-08-22)</span>
    </div>
  {% endif %}

</div>

<div class="title_bar">
  <img class="image" src="data:image/svg+xml;base64,{{ title_bar_icon }}">
  <span class="title">Vuelta a España</span>
  <span class="instance">Classification{% if last_stage %} · Stage {{ last_stage.number }}{% endif %}</span>
</div>
