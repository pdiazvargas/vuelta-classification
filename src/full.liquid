<div class="layout layout--col gap--small">

  {% if has_gc %}
    <div class="grid grid--cols-12 gap portrait:grid--cols-1 portrait:gap--small">
      <div class="col--span-4 flex flex--col gap--small">
        <span class="label label--filled no-shrink">STAGE {{ last_stage.number }} WINNERS</span>
        {% if has_stage_result %}
          <div class="flex flex--col gap--small w--full">
            {% for row in stage_rows limit: 3 %}
              <div class="item">
                <div class="meta">
                  <span class="index">{{ row.position }}</span>
                </div>
                <div class="content">
                  <span class="title title--small">{{ row.name | upcase | truncate: 24 }}</span>
                  <span class="description">{{ row.team | upcase | truncate: 28 }}</span>
                </div>
              </div>
            {% endfor %}
          </div>
        {% else %}
          <span class="label label--gray label--small">Stage result not available</span>
        {% endif %}
      </div>

      <div class="col--span-8">
        <table class="table table--small" data-table-limit="true">
          <thead>
            <tr>
              <th class="pr--3"><span class="label label--small">#</span></th>
              <th><span class="label label--small">RIDER</span></th>
              <th><span class="label label--small">TEAM</span></th>
              <th><span class="label label--small">GAP</span></th>
            </tr>
          </thead>
          <tbody>
            {% for row in gc_rows limit: 10 %}
              <tr>
                <td class="pr--3"><span class="value value--xsmall value--tnums">{{ row.position }}</span></td>
                <td><span class="label">{{ row.name | upcase | truncate: 20 }}</span></td>
                <td><span class="label label--gray">{{ row.team | upcase | truncate: 24 }}</span></td>
                <td><span class="label text--gray-25">{% if row.gap %}+{{ row.gap }}{% else %}—{% endif %}</span></td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  {% else %}
    <div class="flex flex--row flex--center h--full w--full">
      <span class="label label--gray">General classification not available yet — check back once the race is underway (starts 2026-08-22)</span>
    </div>
  {% endif %}

</div>

<div class="title_bar">
  <img class="image" src="data:image/svg+xml;base64,{{ title_bar_icon }}">
  <span class="title">Vuelta a España</span>
  <span class="instance">{% if last_stage %}Stage {{ last_stage.number }} of 21 · {{ last_stage_date_label }}{% else %}Classification{% endif %}</span>
</div>
