<div class="layout layout--col layout--center gap--xsmall text--center">

  <span class="label label--gray label--small">RACE LEADER</span>

  {% if has_gc %}
    <span class="title title--base">{{ gc_leader.name | upcase | truncate: 22 }}</span>
    <span class="label label--small">{{ gc_leader.team | upcase | truncate: 26 }}</span>
  {% else %}
    <span class="label label--gray">Not available yet</span>
  {% endif %}

  {% if has_stage_result %}
    <span class="label label--small label--gray">STAGE {{ last_stage.number }} WINNER · {{ stage_winner.name | upcase | truncate: 18 }}</span>
  {% endif %}

</div>

<div class="title_bar">
  <img class="image" src="data:image/svg+xml;base64,{{ title_bar_icon }}">
  <span class="title">Vuelta a España</span>
  <span class="instance">{% if last_stage %}Stage {{ last_stage.number }} of 21{% else %}Classification{% endif %}</span>
</div>
